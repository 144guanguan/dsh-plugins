{
  "name": "dsh-prompt-autocomplete",
  "version": "0.1.0",
  "description": "Continues the message you are typing as inline ghost text; context includes the conversation, workspace, and @-referenced files. Press Tab to accept the continuation.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "autocomplete",
    "ghost-text"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/144guanguan/dsh-plugins.git",
    "directory": "plugins/prompt-autocomplete"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
